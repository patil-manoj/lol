# Environment Variables for Mobile App

# Backend API URL
# For local development (using your computer's IP address):
# EXPO_PUBLIC_API_URL=http://YOUR_IP_ADDRESS:3000
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# 
# For production (deployed Next.js app):
# EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://10.217.101.221:3000
